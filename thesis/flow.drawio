        <mxCell id="p2" parent="1" vertex="1" value="&lt;b&gt;SELECT&lt;/b&gt;&lt;br&gt;&lt;br&gt;narrow the class to one&lt;br&gt;cause-level blueprint&lt;br&gt;&lt;i&gt;— the hard part —&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D4EDEC;strokeColor=#0B6E6E;strokeWidth=8;fontSize=23;">
          <mxGeometry x="950" y="1800" width="440" height="250" as="geometry" /></mxCell>
        <mxCell id="p3" parent="1" vertex="1" value="&lt;b&gt;RUN&lt;/b&gt;&lt;br&gt;&lt;br&gt;collect the telemetry it&lt;br&gt;asks for, then execute&lt;br&gt;its steps in order" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A7B15;strokeWidth=5;fontSize=23;">
          <mxGeometry x="1460" y="1800" width="440" height="250" as="geometry" /></mxCell>
        <mxCell id="p4" parent="1" vertex="1" value="&lt;b&gt;DECIDE&lt;/b&gt;&lt;br&gt;&lt;br&gt;does the decision rule&lt;br&gt;hold? or did a&lt;br&gt;rule-out fire?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A7B15;strokeWidth=5;fontSize=23;">
          <mxGeometry x="1970" y="1800" width="440" height="250" as="geometry" /></mxCell>
        <mxCell id="p5" parent="1" vertex="1" value="&lt;b&gt;VERDICT&lt;/b&gt;&lt;br&gt;&lt;br&gt;the fault, where and when&lt;br&gt;— or &lt;b&gt;abstain&lt;/b&gt;: &quot;no blueprint&lt;br&gt;fits this evidence&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A7B15;strokeWidth=6;fontSize=23;">
          <mxGeometry x="2480" y="1800" width="440" height="250" as="geometry" /></mxCell>

        <mxCell id="eC0" parent="1" edge="1" source="agent" target="p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=5;strokeColor=#9A7B15;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eC1" parent="1" edge="1" source="p1" target="p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=5;strokeColor=#9A7B15;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eC2" parent="1" edge="1" source="p2" target="p3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=5;strokeColor=#9A7B15;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eC3" parent="1" edge="1" source="p3" target="p4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=5;strokeColor=#9A7B15;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eC4" parent="1" edge="1" source="p4" target="p5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=5;strokeColor=#9A7B15;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="eLibSel" parent="1" edge="1" source="selnote" target="p2" value="&lt;b&gt;candidates&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=8;strokeColor=#0B6E6E;endArrow=blockThin;endFill=1;exitX=0.292;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=21;labelBackgroundColor=#FFF6E0;fontColor=#0B6E6E;">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eRuleOut" parent="1" edge="1" source="p4" target="p2" value="&lt;b&gt;a rule-out fired&lt;/b&gt; — try the next blueprint rather than force an answer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=4;strokeColor=#0B6E6E;dashed=1;dashPattern=10 7;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=20;labelBackgroundColor=#FFF6E0;fontColor=#0B6E6E;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="2190" y="2085" /><mxPoint x="1170" y="2085" /></Array>
          </mxGeometry></mxCell>
        <mxCell id="eBC" parent="1" edge="1" source="b5" target="hierbox" value="&lt;b&gt;+1 in the library&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=5;strokeColor=#3D7A3D;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;fontSize=21;labelBackgroundColor=#FFF6E0;fontColor=#3D7A3D;">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- TWO FEEDBACK PATHS -->
        <mxCell id="eFb1" parent="1" edge="1" source="p5" target="b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=6;strokeColor=#B85450;dashed=1;dashPattern=12 8;endArrow=blockThin;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="3030" y="1987" /><mxPoint x="3030" y="685" /><mxPoint x="1400" y="685" /></Array>
          </mxGeometry></mxCell>
        <mxCell id="fb1Label" parent="1" vertex="1" value="&lt;b&gt;FEEDBACK (a)&lt;/b&gt; — a wrong or hedged verdict&lt;br&gt;revises the blueprint" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#B85450;">
          <mxGeometry x="1760" y="604" width="1180" height="68" as="geometry" /></mxCell>

        <mxCell id="eFb2" parent="1" edge="1" source="p5" target="a3box" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=6;strokeColor=#B85450;dashed=1;dashPattern=12 8;endArrow=blockThin;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.436;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="3065" y="1862" /><mxPoint x="3065" y="118" /><mxPoint x="1480" y="118" /></Array>
          </mxGeometry></mxCell>
        <mxCell id="fb2Label" parent="1" vertex="1" value="&lt;b&gt;FEEDBACK (b)&lt;/b&gt; — and decides what telemetry&lt;br&gt;is worth collecting next time" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#B85450;fillColor=#EBF2FA;strokeColor=none;">
          <mxGeometry x="1900" y="86" width="1080" height="64" as="geometry" /></mxCell>

        <!-- BAND 4 : EVALUATION -->
        <mxCell id="titleD" parent="1" vertex="1" value="&lt;b&gt;4 &#160;EVALUATE&lt;/b&gt; &#160;— does captured expertise actually help?" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontColor=#444444;">
          <mxGeometry x="80" y="2192" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="scopeD" parent="1" vertex="1" value="across &lt;b&gt;~10 operational issue classes&lt;/b&gt; and three kinds of system: &lt;b&gt;microservice&lt;/b&gt; (two applications, done) · &lt;b&gt;monolithic&lt;/b&gt; (micro-benchmarks) · &lt;b&gt;agent-based&lt;/b&gt; (the agent is itself observed)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=21;fontColor=#444444;">
          <mxGeometry x="80" y="2234" width="2860" height="34" as="geometry" /></mxCell>

        <mxCell id="arm1" parent="1" vertex="1" value="&lt;b&gt;THE AGENT &lt;u&gt;WITH&lt;/u&gt; THE LIBRARY&lt;/b&gt;&lt;br&gt;&lt;br&gt;selects a blueprint and executes it" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#9A7B15;strokeWidth=5;fontSize=21;">
          <mxGeometry x="120" y="2290" width="850" height="180" as="geometry" /></mxCell>
        <mxCell id="arm2" parent="1" vertex="1" value="&lt;b&gt;THE SAME AGENT &lt;u&gt;WITHOUT&lt;/u&gt; IT&lt;/b&gt;&lt;br&gt;&lt;br&gt;same model, same incidents, same evidence —&lt;br&gt;the only difference is the library" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=5;fontSize=21;">
          <mxGeometry x="1030" y="2290" width="850" height="180" as="geometry" /></mxCell>
        <mxCell id="arm3" parent="1" vertex="1" value="&lt;b&gt;A DETERMINISTIC BASELINE&lt;/b&gt;&lt;br&gt;&lt;br&gt;the same blueprints as plain rules, &lt;b&gt;no model at all&lt;/b&gt; —&lt;br&gt;a strong control, not a strawman" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=5;fontSize=21;">
          <mxGeometry x="1940" y="2290" width="940" height="180" as="geometry" /></mxCell>

        <mxCell id="rq1" parent="1" vertex="1" value="&lt;b&gt;DOES IT TRANSFER?&lt;/b&gt;&lt;br&gt;&lt;br&gt;author on one run — test on&lt;br&gt;another service, another system" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#444444;strokeWidth=3;fontSize=20;">
          <mxGeometry x="120" y="2510" width="690" height="190" as="geometry" /></mxCell>
        <mxCell id="rq2" parent="1" vertex="1" value="&lt;b&gt;DOES IT ABSTAIN?&lt;/b&gt;&lt;br&gt;&lt;br&gt;on a fault no blueprint covers,&lt;br&gt;does the library stay quiet&lt;br&gt;or mislead?" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#444444;strokeWidth=3;fontSize=20;">
          <mxGeometry x="840" y="2510" width="690" height="190" as="geometry" /></mxCell>
        <mxCell id="rq3" parent="1" vertex="1" value="&lt;b&gt;EXECUTABLE &amp;gt; PROSE?&lt;/b&gt;&lt;br&gt;&lt;br&gt;runnable code in the blueprint&lt;br&gt;vs the same step as text" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#444444;strokeWidth=3;fontSize=20;">
          <mxGeometry x="1560" y="2510" width="690" height="190" as="geometry" /></mxCell>
        <mxCell id="rq4" parent="1" vertex="1" value="&lt;b&gt;IS THE EVIDENCE ENOUGH?&lt;/b&gt;&lt;br&gt;&lt;br&gt;can the right blueprint be chosen&lt;br&gt;from available evidence alone?&lt;br&gt;&lt;i&gt;— the measured bottleneck —&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D4EDEC;strokeColor=#0B6E6E;strokeWidth=4;fontSize=20;">
          <mxGeometry x="2280" y="2510" width="690" height="190" as="geometry" /></mxCell>

        <mxCell id="eCD" parent="1" edge="1" source="p5" target="bandD" value="&lt;b&gt;every run scored against the ground truth&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=5;strokeColor=#666666;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.898;entryY=0;entryDx=0;entryDy=0;fontSize=20;labelBackgroundColor=#FFF6E0;fontColor=#444444;">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- PROVENANCE -->
        <mxCell id="provbox" parent="1" vertex="1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9E9E9E;strokeWidth=3;dashed=1;dashPattern=10 8;">
          <mxGeometry x="40" y="2800" width="2960" height="130" as="geometry" /></mxCell>
        <mxCell id="gh" parent="1" vertex="1" value="" style="dashed=0;outlineConnect=0;html=1;align=center;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.weblogos.github;">
          <mxGeometry x="130" y="2823" width="90" height="85" as="geometry" /></mxCell>
        <mxCell id="ghT" parent="1" vertex="1" value="A blueprint is a &lt;b&gt;file in git&lt;/b&gt; — reviewable, diffable, versioned like code." style="text;html=1;align=left;verticalAlign=middle;fontSize=22;">
          <mxGeometry x="250" y="2835" width="1100" height="60" as="geometry" /></mxCell>
        <mxCell id="jira" parent="1" vertex="1" value="" style="image;html=1;image=img/lib/atlassian/Jira_Logo.svg;">
          <mxGeometry x="1480" y="2818" width="100" height="95" as="geometry" /></mxCell>
        <mxCell id="jiraT" parent="1" vertex="1" value="&lt;b&gt;FUTURE WORK&lt;/b&gt; — mine blueprints from resolved tickets, instead of authoring every one by hand." style="text;html=1;align=left;verticalAlign=middle;fontSize=22;">
          <mxGeometry x="1610" y="2835" width="1330" height="60" as="geometry" /></mxCell>

      </root>
