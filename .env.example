# Copy to .env and fill in.  .env is git-ignored — never commit real secrets.
# Load it before running the agent, e.g.:  set -a; source .env; set +a
# (or on the Trillium login node:  source transfer/env.sh; set -a; source .env; set +a)
#
# These are read by agentic-rca/config.py (the RCA agent, method #3).

# --- required for the LLM agent (method #3) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- model / provider (optional; defaults shown) ---
RCA_PROVIDER=claude            # claude | openai | ollama
RCA_MODEL=                     # blank = provider default (claude-opus-4-8); e.g. claude-sonnet-5
RCA_TEMPERATURE=0              # 0 = reproducible for the study
RCA_MAX_TOKENS=4096

# --- only if RCA_PROVIDER=openai ---
# OPENAI_API_KEY=sk-...

# --- study data (optional; defaults match the cluster layout) ---
STRATATRACE_APP=trainticket    # trainticket | sockshop  (kernel service-map profile)
RUNS_ROOT=/scratch/yuvraj17/agentic-runs
