# Copy to .env and fill in.  .env is git-ignored — never commit real secrets.
# Load it before running the agent, e.g.:  set -a; source .env; set +a
# (on Trillium login node:  source transfer/env.sh; set -a; source .env; set +a)
#
# Read by agentic-rca/config.py. Pick ONE provider via RCA_PROVIDER; only that provider's
# key(s) need to be set. Everything else in the harness is provider-agnostic.

RCA_PROVIDER=azure             # claude | azure | gemini | openai | ollama
RCA_MODEL=gpt-5.4              # blank = provider default; see per-provider examples below
RCA_MAX_TOKENS=4096
# GPT-5 / reasoning models reject a custom temperature → leave this 0 (temperature omitted).
# Set to 1 only for models that accept RCA_TEMPERATURE (e.g. Claude, gpt-4o).
RCA_SEND_TEMPERATURE=0
RCA_TEMPERATURE=0

# --- Anthropic (RCA_PROVIDER=claude) — RCA_MODEL=claude-opus-4-8 | claude-sonnet-5 ---
ANTHROPIC_API_KEY=

# --- Azure OpenAI (RCA_PROVIDER=azure) — RCA_MODEL=gpt-5.4 | gpt-5.4-mini | gpt-5.4-nano ---
# endpoint = the OpenAI-compatible v1 surface (…/openai/v1)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://brock2-resource.openai.azure.com/openai/v1

# --- Google Gemini (RCA_PROVIDER=gemini) — RCA_MODEL=gemini-2.5-pro | gemini-2.5-flash ---
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # default; usually leave unset

# --- OpenAI direct (RCA_PROVIDER=openai) — RCA_MODEL=gpt-4o etc. ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                                                            # optional (proxies)

# --- local Ollama (RCA_PROVIDER=ollama) — RCA_MODEL=llama3.1:8b, no key ---
# OLLAMA_URL=http://localhost:11434/v1

# --- study data (optional; defaults match the cluster layout) ---
STRATATRACE_APP=trainticket    # trainticket | sockshop  (kernel service-map profile)
RUNS_ROOT=/scratch/yuvraj17/agentic-runs
