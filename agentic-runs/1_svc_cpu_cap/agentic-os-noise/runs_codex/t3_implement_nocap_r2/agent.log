 def encode(s):
     """Run-length encode a string: 'aaabbc' -> 'a3b2c1'.
     Empty string -> ''. Single run counts included (always a count)."""
-    raise NotImplementedError
+    if not s:
+        return ""
 
+    encoded = []
+    current = s[0]
+    count = 1
+    for char in s[1:]:
+        if char == current:
+            count += 1
+        else:
+            encoded.append(current)
+            encoded.append(str(count))
+            current = char
+            count = 1
+    encoded.append(current)
+    encoded.append(str(count))
+    return "".join(encoded)
+
 def decode(s):
     """Inverse of encode: 'a3b2c1' -> 'aaabbc'. Counts are 1+ digits."""
-    raise NotImplementedError
+    decoded = []
+    i = 0
+    while i < len(s):
+        char = s[i]
+        i += 1
+        start = i
+        while i < len(s) and s[i].isdigit():
+            i += 1
+        if start == i:
+            raise ValueError("each encoded character must be followed by a count")
+        decoded.append(char * int(s[start:i]))
+    return "".join(decoded)

