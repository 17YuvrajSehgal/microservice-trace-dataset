def encode(s):
    """Run-length encode a string: 'aaabbc' -> 'a3b2c1'.
    Empty string -> ''. Single run counts included (always a count)."""
    raise NotImplementedError

def decode(s):
    """Inverse of encode: 'a3b2c1' -> 'aaabbc'. Counts are 1+ digits."""
    raise NotImplementedError
