import time
from rle import encode, decode
from intervals import merge

assert encode("") == ""
assert encode("aaabbc") == "a3b2c1"
assert decode("a3b2c1") == "aaabbc"
assert decode(encode("xxxxxxxxxx yy")) == "xxxxxxxxxx yy"
assert merge([[1, 3], [2, 6], [8, 10]]) == [[1, 6], [8, 10]]
