 def decode(s):
     """Inverse of encode: 'a3b2c1' -> 'aaabbc'. Counts are 1+ digits."""
-    raise NotImplementedError
+    parts = []
+    i = 0
+    while i < len(s):
+        char = s[i]
+        i += 1
+        count_start = i
+        while i < len(s) and s[i].isdigit():
+            i += 1
+        if count_start == i:
+            raise ValueError("each encoded character must be followed by a count")
+        parts.append(char * int(s[count_start:i]))
+    return "".join(parts)

