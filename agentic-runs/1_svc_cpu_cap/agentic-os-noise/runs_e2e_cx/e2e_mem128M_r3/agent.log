 def encode(s):
     """Run-length encode a string: 'aaabbc' -> 'a3b2c1'.
     Empty string -> ''. Single run counts included (always a count)."""
-    raise NotImplementedError
+    if not s:
+        return ""
 
+    parts = []
+    current = s[0]
+    count = 1
+    for char in s[1:]:
+        if char == current:
+            count += 1
+        else:
+            parts.append(current + str(count))
+            current = char
+            count = 1
+    parts.append(current + str(count))
+    return "".join(parts)
+
 def decode(s):
     """Inverse of encode: 'a3b2c1' -> 'aaabbc'. Counts are 1+ digits."""
-    raise NotImplementedError
+    parts = []
+    i = 0
+    while i < len(s):
+        char = s[i]
+        i += 1
+        count_start = i
+        while i < len(s) and s[i].isdigit():
+            i += 1
+        if count_start == i:
+            raise ValueError("each encoded character must have a count")
+        parts.append(char * int(s[count_start:i]))
+    return "".join(parts)

