{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratatrace.dev/schema/blueprint-1.json",
  "title": "Observability Blueprint",
  "description": "One solved investigation, written down so an agent can redo it unaided. Covers what to COLLECT, what to RUN, and what to PRODUCE. Fields marked harness_only are never shown to a model under evaluation.",
  "type": "object",
  "required": ["id", "version", "problem", "reproduction", "collection_order", "processing", "outputs", "decision", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id":      {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "title":   {"type": "string"},

    "problem": {
      "type": "object",
      "required": ["summary", "symptoms", "discriminators"],
      "additionalProperties": false,
      "properties": {
        "summary":  {"type": "string", "description": "One SPECIFIC situation, not a generic fault class."},
        "symptoms": {"type": "array", "items": {"type": "string"},
                     "description": "What a human first notices. Evidence only - must never name the fault."},
        "discriminators": {
          "type": "array", "minItems": 1,
          "description": "The signals that separate THIS problem from its look-alikes. This is the part that carries the expertise.",
          "items": {
            "type": "object",
            "required": ["signal", "this_problem", "not_this_problem"],
            "additionalProperties": false,
            "properties": {
              "signal":           {"type": "string"},
              "this_problem":     {"type": "string"},
              "not_this_problem": {"type": "string"},
              "confused_with":    {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },

    "reproduction": {
      "type": "object",
      "required": ["system", "recipe"],
      "additionalProperties": false,
      "properties": {
        "system":     {"type": "string"},
        "recipe":     {"type": "string", "description": "Path to the runnable fault script."},
        "invoke":     {"type": "string"},
        "teardown":   {"type": "string"},
        "labelled_examples": {"type": "array", "items": {"type": "string"},
                              "description": "harness_only: run ids that exhibit this problem."},
        "harness_only": {"type": "array", "items": {"type": "string"}, "default": ["labelled_examples"]}
      }
    },

    "collection_order": {
      "type": "object",
      "description": "What to record. A blueprint dictates collection, it does not only consume it.",
      "required": ["window", "kernel_events"],
      "additionalProperties": false,
      "properties": {
        "window":        {"type": "object", "additionalProperties": false,
                          "properties": {"baseline_s": {"type": "integer"}, "incident_s": {"type": "integer"},
                                         "recovery_s": {"type": "integer"}}},
        "kernel_events": {"type": "array", "items": {"type": "string"},
                          "description": "EXACT tracepoint names - not families, not 'kernel data'."},
        "metrics":       {"type": "array", "items": {"type": "string"}},
        "logs":          {"type": "array", "items": {"type": "string"}},
        "traces":        {"type": "array", "items": {"type": "string"}},
        "why_these":     {"type": "string", "description": "Why this minimal set is sufficient."}
      }
    },

    "processing": {
      "type": "array", "minItems": 1,
      "description": "Ordered steps. Each carries an EXACT callable - a command line, not prose. Naming the exact code is what cuts model non-determinism.",
      "items": {
        "type": "object",
        "required": ["step", "run", "produces"],
        "additionalProperties": false,
        "properties": {
          "step":     {"type": "string"},
          "run":      {"type": "string", "description": "Runnable command. Placeholders in <angle brackets>."},
          "cwd":      {"type": "string"},
          "produces": {"type": "string"},
          "reads":    {"type": "array", "items": {"type": "string"}},
          "expect":   {"type": "string", "description": "What a correct result looks like, so failure is detectable."}
        }
      }
    },

    "outputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "additionalProperties": false,
        "properties": {
          "kind":     {"enum": ["json", "xy_chart", "timeline", "text", "table"]},
          "path":     {"type": "string"},
          "contains": {"type": "string"}
        }
      }
    },

    "decision": {
      "type": "object",
      "description": "How to turn the outputs into a verdict, including when NOT to conclude this problem.",
      "required": ["verdict_when", "rule_out", "root_cause_is"],
      "additionalProperties": false,
      "properties": {
        "verdict_when":  {"type": "array", "items": {"type": "string"}},
        "rule_out":      {"type": "array", "items": {"type": "object", "required": ["instead", "when"],
                          "additionalProperties": false,
                          "properties": {"instead": {"type": "string"}, "when": {"type": "string"}}}},
        "root_cause_is": {"type": "string"},
        "fault_type":    {"type": "string", "description": "harness_only: label for scoring. NEVER shown to a model under evaluation."}
      }
    },

    "evidence_from_literature": {
      "type": "array",
      "items": {"type": "object", "required": ["claim", "source", "validated_on"],
                "additionalProperties": false,
                "properties": {"claim": {"type": "string"}, "source": {"type": "string"},
                               "validated_on": {"type": "string"}}}
    },

    "related_blueprints": {"type": "array", "items": {"type": "string"}},
    "mutually_exclusive_with": {"type": "array", "items": {"type": "string"},
      "description": "Blueprints that cannot both be right for one incident - the orchestrator must choose."},

    "provenance": {
      "type": "object",
      "required": ["authored_by", "verified_by", "authored_utc"],
      "additionalProperties": false,
      "properties": {
        "authored_by": {"type": "string", "description": "human | mined:<ref>"},
        "verified_by": {"type": "string", "description": "the human who checked it is complete - part of the loop, not an afterthought"},
        "authored_utc": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
