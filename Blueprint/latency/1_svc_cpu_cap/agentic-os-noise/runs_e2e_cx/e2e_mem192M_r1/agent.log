 def decode(s):
     """Inverse of encode: 'a3b2c1' -> 'aaabbc'. Counts are 1+ digits."""
-    raise NotImplementedError
+    decoded = []
+    index = 0
+    while index < len(s):
+        char = s[index]
+        index += 1
+        count_start = index
+        while index < len(s) and s[index].isdigit():
+            index += 1
+        if count_start == index:
+            raise ValueError("run-length encoded character is missing its count")
+        decoded.append(char * int(s[count_start:index]))
+    return "".join(decoded)

